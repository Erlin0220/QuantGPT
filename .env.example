# QuantGPT Environment Configuration
# Copy this file to .env and fill in your values

# The QuantGPT HTTP/MCP server itself does not require or call an LLM provider.
# Optional repo-local WorldQuant research can use OpenCode Go / DeepSeek independently.
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://opencode.ai/zen/go/v1
# DEEPSEEK_MODEL=deepseek-v4-flash
# WQ_LOCAL_RESEARCH_REASONING_POLICY=adaptive
# WQ_LOCAL_RESEARCH_TARGET_SIMULATIONS=100
# WQ_LOCAL_RESEARCH_BUDGET_MINUTES=50
# WQ_LOCAL_RESEARCH_BATCH_SIZE=4
# WQ_LOCAL_RESEARCH_SIMULATIONS_PER_BATCH=4

# Database — SQLite (default, zero config) or PostgreSQL
# Leave empty for SQLite (./quantgpt.db), or set PostgreSQL URL:
# DATABASE_URL=postgresql+asyncpg://quantgpt:your_password@localhost:5433/quantgpt
DATABASE_URL=

# Local Development Mode
# Set to true to disable authentication (no login required, no SMTP needed)
# WARNING: Never enable in production!
AUTH_DISABLED=true

# JWT Authentication (not needed if AUTH_DISABLED=true)
JWT_SECRET_KEY=generate_a_random_64_char_hex_string
JWT_ACCESS_TOKEN_EXPIRE_HOURS=24
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Remote MCP authentication and bounded background execution
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
QUANTGPT_MCP_API_KEY=
QUANTGPT_TRUSTED_PROXY_IPS=127.0.0.1,::1
QUANTGPT_MCP_ALLOWED_HOSTS=localhost,localhost:8003,127.0.0.1,127.0.0.1:8003
QUANTGPT_MCP_BACKGROUND_WORKERS=8
QUANTGPT_LOCAL_TASK_TIMEOUT=600
QUANTGPT_MAX_FACTOR_VALUE_ARTIFACTS=100
QUANTGPT_MAX_FACTOR_VALUE_ARTIFACT_MB=64
QUANTGPT_MAX_FACTOR_VALUE_TOTAL_MB=512
QUANTGPT_FACTOR_VALUE_ARTIFACT_TTL_SECONDS=86400
WQ_HTTP_CONNECT_TIMEOUT=10
WQ_HTTP_READ_TIMEOUT=60

# SMTP — Email verification codes
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=your_email@example.com
SMTP_USE_TLS=true

# Feedback Webhook (optional, Feishu/Lark)
QUANTGPT_FEEDBACK_WEBHOOK=
QUANTGPT_FEEDBACK_WEBHOOK_SECRET=

# RiceQuant (rqdatac) — primary A-share data source (optional)
RQDATAC_USERNAME=
RQDATAC_PASSWORD=

# Admin
QUANTGPT_ADMIN_PASSWORD=change_this_password

# App tuning (optional)
QUANTGPT_MAX_ACTIVE_TASKS=100
QUANTGPT_RATE_LIMIT=50
QUANTGPT_CORS_ORIGINS=http://localhost:5173,http://localhost:8002

# Task execution backend: "process" (default, multi-core) or "celery" (distributed) or "thread" (legacy)
QUANTGPT_TASK_BACKEND=process
QUANTGPT_WORKER_PROCESSES=4

# Rust engine: set to 0 to disable (falls back to pure Python)
QUANTGPT_RUST_ENGINE=1

# WorldQuant BRAIN API (optional — enables real WQ alpha submission)
WQ_BRAIN_EMAIL=
WQ_BRAIN_PASSWORD=
# Formal submission policy: target 2 ACTIVE Alphas per Asia/Shanghai day.
# Legacy WQ_DAILY_SUBMISSION_BUDGET is still accepted when ACTIVE target is unset.
WQ_DAILY_ACTIVE_TARGET=2
WQ_SUBMISSION_TIMEZONE=Asia/Shanghai
WQ_REQUIRE_PRE_SUBMIT_ROBUSTNESS=0
WQ_SUBMISSION_RESERVATION_TTL_SECONDS=900
WQ_SUBMISSION_MAX_LOCAL_CORRELATION=0.70
WQ_SUBMISSION_MIN_OVERFIT_SCORE=0.50

# QuantGPT Cloud (optional — enables independent validation at quant-gpt.com)
QUANTGPT_CLOUD_EMAIL=
QUANTGPT_CLOUD_PASSWORD=

# Celery (only needed if QUANTGPT_TASK_BACKEND=celery)
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0
